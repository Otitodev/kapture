---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import AgentInstallPrompt from '../../components/AgentInstallPrompt.astro';
import { SITE_URL } from '../../consts';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/docs/${entry.id}/`;
const article = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  url: new URL(path, SITE_URL).toString(),
  publisher: { '@type': 'Organization', name: 'Kapture', url: SITE_URL },
};
---

<Article
  title={`${entry.data.title} — Kapture docs`}
  heading={entry.data.title}
  description={entry.data.description}
  structuredData={article}
  breadcrumbs={[
    { name: 'Kapture', path: '/' },
    { name: 'Docs', path: '/docs/' },
    { name: entry.data.title, path },
  ]}
>
  <Content />
  {entry.id === 'install' && <AgentInstallPrompt slot="after" />}
</Article>
