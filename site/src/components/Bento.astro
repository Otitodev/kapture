---
const shortcuts: Array<[string[], string]> = [
  [['⌘', '▲', '1'], 'visible area'],
  [['⌘', '▲', '2'], 'selected region'],
  [['⌘', '▲', '3'], 'full page'],
  [['⌘', '▲', '5'], 'record tab'],
];
---

<section id="features" class="scroll-mt-24 px-5 pt-16 sm:px-8 sm:pt-20 lg:px-16 lg:pt-24">
  <p class="font-mono text-[12px] tracking-[0.08em] text-muted">EVERYTHING INCLUDED</p>
  <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-5">
    <div class="col-span-1 flex min-h-[300px] flex-col gap-3.5 rounded-xl border border-rule bg-surface p-5 sm:min-h-[340px] sm:p-7 md:col-span-2 lg:col-span-3">
      <p class="font-mono text-[12px] tracking-[0.08em] text-muted">SCREENSHOTS</p>
      <h2 class="text-[24px] font-semibold leading-[30px] text-fg">capture any part of a page</h2>
      <p class="text-[15px] leading-[23px] text-muted">Save the visible page, a selected region, the full page, or one element.</p>
      <div class="mt-auto grid grid-cols-1 gap-4 pt-3 md:grid-cols-2 md:gap-[18px]">
        {shortcuts.map(([keys, label]) => (
          <div class="flex flex-col gap-2.5">
            <div class="flex gap-1.5">
              {keys.map((k) => (
                <kbd class="flex h-10 min-w-10 items-center justify-center rounded-lg border-b-4 border-muted bg-fg px-2 font-mono text-[14px] font-semibold text-bg sm:h-12 sm:min-w-12 sm:px-3 sm:text-[16px]">{k}</kbd>
              ))}
            </div>
            <span class="font-mono text-[13px] text-fg">{label}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="col-span-1 flex min-h-[300px] flex-col gap-3.5 rounded-xl border border-rule bg-surface p-5 sm:min-h-[340px] sm:p-7 lg:col-span-2">
      <p class="font-mono text-[12px] tracking-[0.08em] text-record">SCREEN RECORDINGS</p>
      <h2 class="text-[24px] font-semibold leading-[30px] text-fg">record a tab or screen</h2>
      <p class="text-[15px] leading-[23px] text-muted">Save a browser walkthrough with tab audio and an optional microphone.</p>
      <div class="flex flex-1 items-center justify-center rounded-lg bg-bg">
        <div class="flex items-center gap-2.5 rounded-full border border-rule bg-surface px-2.5 py-2">
          <span class="size-2.5 rounded-full bg-record" aria-hidden="true"></span>
          <span class="font-mono text-[12px] text-muted">0:01</span>
          <span class="rounded-full bg-record px-3 py-[3px] text-[13px] font-semibold text-white">stop</span>
        </div>
      </div>
    </div>
    <div class="col-span-1 flex min-h-[300px] flex-col gap-3.5 rounded-xl border border-rule bg-surface p-5 sm:min-h-[340px] sm:p-7 lg:col-span-2">
      <p class="font-mono text-[12px] tracking-[0.08em] text-muted">ANNOTATIONS</p>
      <h2 class="text-[24px] font-semibold leading-[30px] text-fg">show what needs attention</h2>
      <p class="text-[15px] leading-[23px] text-muted">Add arrows, boxes, text, blur, and numbered steps before saving or sharing.</p>
      <div class="mt-auto flex flex-1 flex-col rounded-lg bg-[#F7F7F2] p-[18px]">
        <p class="text-[14px] font-semibold text-[#181818]">payment</p>
        <div class="mt-2.5 h-2 w-[120px] rounded bg-[#D8D8D2]"></div>
        <div class="relative mt-3 self-start">
          <p class="text-[13px] font-medium text-[#D93A2F]">card declined — try again</p>
          <div class="pointer-events-none absolute -inset-x-2 -inset-y-[7px] rounded-[5px] border-[3px] border-[#FF5A4F]" aria-hidden="true"></div>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <svg width="52" height="26" viewBox="0 0 52 26" fill="none" aria-hidden="true"><defs><marker id="flag-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#FF5A4F" /></marker></defs><path d="M4 4 C 24 4, 30 12, 44 18" stroke="#FF5A4F" stroke-width="3" stroke-linecap="round" marker-end="url(#flag-arrow)" /></svg>
          <span class="text-[13px] font-medium text-[#181818]">flag it for support</span>
        </div>
      </div>
    </div>
    <div class="col-span-1 flex min-h-[300px] flex-col gap-3.5 rounded-xl border border-rule bg-surface p-5 sm:min-h-[340px] sm:p-7 md:col-span-2 lg:col-span-3">
      <p class="font-mono text-[12px] tracking-[0.08em] text-muted">LOCAL LIBRARY</p>
      <h2 class="text-[24px] font-semibold leading-[30px] text-fg">find captures later</h2>
      <p class="text-[15px] leading-[23px] text-muted">Search by title or site, organize captures in folders, and clean up old files on this device.</p>
      <div class="mt-auto flex flex-1 flex-col gap-2.5 rounded-lg bg-bg p-3.5">
        <div class="flex items-center gap-2">
          <div class="h-[26px] flex-1 rounded border border-rule-strong"></div>
          <span class="font-mono text-[9px] text-muted">all</span>
          <span class="font-mono text-[9px] text-muted">week</span>
        </div>
        <div class="flex gap-2.5">
          {[
            ['checkout error state', 'shop.acme.com'],
            ['pricing v2 hero', 'acme.com'],
            ['onboarding walkthrough', 'app.acme.com · 02:14'],
          ].map(([t, u]) => (
            <div class="flex min-w-0 flex-1 flex-col gap-[7px]">
              <div class="h-[78px] rounded-md border border-rule-strong bg-raised"></div>
              <p class="truncate text-[11px] font-medium text-fg">{t}</p>
              <p class="truncate font-mono text-[9px] text-muted">{u}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
