---
import { REPO_URL } from '../consts';
---

<section class="flex flex-col items-center px-5 pb-20 pt-20 text-center sm:px-8 sm:pb-36 sm:pt-[120px] lg:px-16">
  <h2 class="max-w-2xl text-balance text-[clamp(2rem,7.5vw,3rem)] font-semibold leading-[1.08] tracking-[-0.02em] text-fg">
    capture a bug or walkthrough<br class="hidden sm:block" /> in seconds
  </h2>
  <a href={REPO_URL} class="mt-8 inline-flex min-h-12 w-full max-w-sm items-center justify-center rounded-md bg-fg px-7 text-[16px] font-semibold text-bg sm:w-auto">view the project on GitHub</a>
  <p class="mt-4 font-mono text-[11px] text-muted sm:text-[12px]">free forever for capture · annotate · record</p>
</section>
